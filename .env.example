# ---- Frontend (public values only; never put secrets in a VITE_ variable) ----
VITE_SPLITPAY_ADDRESS=0xd7f9c3823e81fe27300693c060a6418ad3eed806
VITE_SPLITPAY_DEPLOY_BLOCK=69502501
# Optional. Leave unset for Arc Testnet. 5042 switches the frontend to Arc mainnet (real USDC).
# Read docs/MAINNET_CHECKLIST.md first. The API server is testnet only.
# VITE_SPLITPAY_CHAIN_ID=5042

# Accounts (email sign-in, invitations, reminders, NGN sandbox) are optional and OFF by default.
# They appear only if this is "true" AND the API answers /api/health. A static host (for example Vercel with no API) shows none of it.
# VITE_ACCOUNTS_ENABLED=true

# ---- API server (consumer-v2). Server-side secrets: set in the host's secret store, never commit ----
# APP_ENV=production          # development (default) shows codes in a dev outbox; production sends real mail only
# PORT=7860                   # or SERVER_PORT. Default 3001
# DATABASE_PATH=/data/splitpay.db
# SERVER_SECRET=              # 32+ random bytes; generated and stored in the database if unset
# APP_BASE_URL=https://your-site.example   # used in emailed links
# MAIL_PROVIDER=resend
# RESEND_API_KEY=
# MAIL_FROM="SplitPay <no-reply@your-domain.example>"
# YELLOWCARD_API_KEY=         # not used for live payments yet; see docs/INTEGRATIONS_RESEARCH.md
# YELLOWCARD_SECRET_KEY=
# YELLOWCARD_BASE_URL=https://sandbox.api.yellowcard.io/business
# SANDBOX_NGN_PER_USDC=1500   # DEMO rate for the sandbox provider. Not market data
# SANDBOX_PROVIDER_FEE_BPS=100
